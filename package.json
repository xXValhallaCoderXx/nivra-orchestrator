{
  "name": "nivra-orchestrator",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "verify": "pnpm typecheck && pnpm test",
    "probe:tokenfactory": "pnpm --filter @nivra/engine --fail-if-no-match probe:tokenfactory",
    "rpc": "pnpm --filter @nivra/engine --fail-if-no-match rpc",
    "stage:runtime": "pnpm --filter @nivra/desktop --fail-if-no-match stage:runtime",
    "verify:windows": "pnpm --filter @nivra/desktop --fail-if-no-match verify:windows",
    "dev": "pnpm --filter @nivra/desktop --fail-if-no-match dev",
    "dev:win": "pnpm --filter @nivra/desktop --fail-if-no-match dev:win",
    "package:linux": "pnpm --filter @nivra/desktop --fail-if-no-match package:linux",
    "package:win": "pnpm --filter @nivra/desktop --fail-if-no-match package:win",
    "release:candidate": "pnpm --filter @nivra/desktop --fail-if-no-match release:candidate",
    "accept:live": "pnpm --filter @nivra/desktop --fail-if-no-match accept:live"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  }
}
